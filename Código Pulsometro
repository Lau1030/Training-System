#include <WiFi.h>
#include <esp_now.h>
#include <Wire.h>
#include "MAX30105.h"
#include "heartRate.h"

MAX30105 sensor;

// MAC DEL RECEPTOR PRINCIPAL: EC:E3:34:99:CD:18
uint8_t receptor[] = {
  0xEC, 0xE3, 0x34, 0x99, 0xCD, 0x18
};

// PAQUETE COMUN PARA LOS TRES ESP32
typedef struct {
  uint8_t tipo;
  uint8_t reservado[3];
  int32_t bpm;
  uint32_t golpes;
  float velocidad;
  float temperatura;
} Paquete;

Paquete datos;

const uint8_t TIPO_BPM = 1;

const byte RATE_SIZE = 4;
byte rates[RATE_SIZE];
byte rateSpot = 0;
byte muestras = 0;

long lastBeat = 0;
float beatsPerMinute = 0;
int beatAvg = 0;
int ultimoBPM = 0;

unsigned long ultimoEnvio = 0;

void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println("EMISOR MAX30102");

  // I2C
  Wire.begin(21, 22);
  Wire.setClock(100000);

  // SENSOR
  if (!sensor.begin(Wire, I2C_SPEED_STANDARD)) {
    Serial.println("ERROR: MAX30102 NO DETECTADO");

    while (true) {
      delay(1000);
    }
  }

  sensor.setup();
  sensor.setPulseAmplitudeRed(0x1F);
  sensor.setPulseAmplitudeIR(0x1F);
  sensor.setPulseAmplitudeGreen(0);

  Serial.println("MAX30102 DETECTADO");

  // WIFI
  WiFi.mode(WIFI_STA);
  WiFi.disconnect();

  Serial.print("MAC EMISOR: ");
  Serial.println(WiFi.macAddress());

  // ESP-NOW
  if (esp_now_init() != ESP_OK) {
    Serial.println("ERROR ESP-NOW");
    while (true) delay(1000);
  }

  esp_now_peer_info_t peer = {};
  memcpy(peer.peer_addr, receptor, 6);
  peer.channel = 0;
  peer.encrypt = false;

  if (esp_now_add_peer(&peer) != ESP_OK) {
    Serial.println("ERROR AGREGANDO RECEPTOR");
    while (true) delay(1000);
  }

  memset(&datos, 0, sizeof(datos));
  datos.tipo = TIPO_BPM;

  Serial.println("EMISOR MAX30102 LISTO");
  Serial.println("ENVIANDO AL RECEPTOR PRINCIPAL");
}

void loop() {
  long irValue = sensor.getIR();

  // SIN DEDO
  if (irValue < 50000) {
    ultimoBPM = 0;
    beatAvg = 0;
    rateSpot = 0;
    muestras = 0;
    lastBeat = 0;

    if (millis() - ultimoEnvio >= 2000) {
      datos.tipo = TIPO_BPM;
      datos.bpm = 0;

      esp_err_t resultado = esp_now_send(
        receptor,
        (uint8_t *)&datos,
        sizeof(datos)
      );

      ultimoEnvio = millis();

      Serial.print("SIN DEDO | ENVIO: ");
      Serial.println(resultado == ESP_OK ? "OK" : "ERROR");
    }

    delay(20);
    return;
  }

  // DETECTAR PULSO
  if (checkForBeat(irValue)) {
    long delta = millis() - lastBeat;
    lastBeat = millis();

    if (delta > 0) {
      beatsPerMinute = 60.0 / (delta / 1000.0);

      if (beatsPerMinute > 40 && beatsPerMinute < 180) {
        rates[rateSpot] = (byte)beatsPerMinute;
        rateSpot = (rateSpot + 1) % RATE_SIZE;

        if (muestras < RATE_SIZE) {
          muestras++;
        }

        int suma = 0;

        for (byte i = 0; i < muestras; i++) {
          suma += rates[i];
        }

        beatAvg = suma / muestras;
        ultimoBPM = beatAvg;
      }
    }
  }

  // ENVIAR BPM CADA 1 SEGUNDO
  if (millis() - ultimoEnvio >= 1000 && ultimoBPM > 0) {
    datos.tipo = TIPO_BPM;
    datos.bpm = ultimoBPM;
    datos.golpes = 0;
    datos.velocidad = 0;
    datos.temperatura = 0;

    esp_err_t resultado = esp_now_send(
      receptor,
      (uint8_t *)&datos,
      sizeof(datos)
    );

    ultimoEnvio = millis();

    Serial.print("BPM ENVIADO: ");
    Serial.print(datos.bpm);
    Serial.print(" | RESULTADO: ");
    Serial.println(resultado == ESP_OK ? "OK" : "ERROR");
  }

  delay(20);
}(Sensor max102 )
